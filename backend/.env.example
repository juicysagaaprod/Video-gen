# Create a long-lived API key in the BytePlus ModelArk console:
# https://console.byteplus.com/ark/region:ark+ap-southeast-1/apikey
ARK_API_KEY=your_byteplus_modelark_api_key_here

# Optional override for compatible/self-hosted gateways.
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Required only when uploaded reference videos must be reachable by BytePlus.
# For local development, paste a public HTTPS video URL in the UI instead.
PUBLIC_BASE_URL=

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional
PORT=8787

# The origin your frontend is served from. In production this should be
# your real domain (e.g. https://studio.yourapp.com), not localhost.
ALLOWED_ORIGIN=http://localhost:5173

NODE_ENV=development
